<?xml version="1.0" encoding="utf-8"?>
<!--
  Dropdown layout for Spinner's EXPANDED state.
  Includes checkbox for optional non-sensitive preference (edible marking).
  
  WHY THE CHECKBOX IS INDEPENDENT OF SINGLE-CHOICE SELECTION:
  - Spinner selection = mutually exclusive choice of ONE mushroom type (radio behavior)
  - Checkbox = per-item user preference about edibility (can toggle multiple independently)
  - The checkbox doesn't change which item is selected; it's auxiliary metadata
  - This demonstrates: selection ≠ all user interactions with list items
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_mushroom_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/tv_mushroom_scientific"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_mushroom_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Checkbox for non-sensitive preference (edible marking) -->
    <CheckBox
        android:id="@+id/cb_edible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/checkbox_edible"
        android:textSize="12sp" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Dark -->
    <style name="Base.Theme.Spinneradapter" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_sys_color_primary_fixed_dim</item>
        <item name="colorPrimaryContainer">@color/md_sys_color_primary_fixed</item>
        <item name="colorOnPrimary">@color/md_sys_color_on_primary_fixed</item>
        <item name="colorOnPrimaryContainer">@color/md_sys_color_on_primary_fixed</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/md_sys_color_secondary_fixed_dim</item>
        <item name="colorSecondaryContainer">@color/md_sys_color_secondary_fixed</item>
        <item name="colorOnSecondary">@color/md_sys_color_on_secondary_fixed</item>
        <item name="colorOnSecondaryContainer">@color/md_sys_color_on_secondary_fixed</item>

        <!-- Tertiary brand color -->
        <item name="colorTertiary">@color/md_sys_color_tertiary_fixed_dim</item>
        <item name="colorTertiaryContainer">@color/md_sys_color_tertiary_fixed</item>
        <item name="colorOnTertiary">@color/md_sys_color_on_tertiary_fixed</item>
        <item name="colorOnTertiaryContainer">@color/md_sys_color_on_tertiary_fixed</item>

        <!-- Error color -->
        <item name="colorError">@color/md_sys_color_error</item>
        <item name="colorOnError">@color/md_sys_color_on_error</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/md_sys_color_inverse_surface</item>
        <item name="colorSurface">@color/md_sys_color_inverse_surface</item>
        <item name="colorSurfaceVariant">@color/md_sys_color_surface_variant</item>
        <item name="colorOnSurface">@color/md_sys_color_inverse_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_sys_color_outline</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_sys_color_outline</item>
        <item name="colorOutlineVariant">@color/md_sys_color_outline_variant</item>

        <!-- Status bar and navigation -->
        <item name="android:statusBarColor">@color/md_sys_color_inverse_surface</item>
        <item name="android:navigationBarColor">@color/md_sys_color_inverse_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Text appearance -->
        <item name="android:textColorPrimary">@color/md_sys_color_inverse_on_surface</item>
        <item name="android:textColorSecondary">@color/md_sys_color_outline</item>
        <item name="android:textColorHint">@color/md_sys_color_outline</item>
        <item name="android:textColorLink">@color/md_sys_color_primary_fixed_dim</item>

        <!-- Control colors -->
        <item name="colorControlActivated">@color/md_sys_color_primary_fixed_dim</item>
        <item name="colorControlNormal">@color/md_sys_color_outline</item>
        <item name="colorControlHighlight">@color/md_sys_color_primary_fixed</item>

        <!-- Divider -->
        <item name="android:listDivider">@color/md_sys_color_outline_variant</item>
    </style>

    <style name="Theme.Spinneradapter" parent="Base.Theme.Spinneradapter" />
</resources>